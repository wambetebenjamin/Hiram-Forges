# Site
NEXT_PUBLIC_SITE_URL=https://hiram-forges.vercel.app

# NextAuth (v5). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# reCAPTCHA. Leave blank to use the built in confirmation fallback.
# Set NEXT_PUBLIC_RECAPTCHA_VERSION=v2 for the checkbox widget, or v3 for the score based check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_VERSION=v3
RECAPTCHA_SECRET_KEY=

# Optional webhook for listing and contact submissions (Slack, Formspark, n8n and similar).
# When it is empty, submissions return a WhatsApp hand off link so nothing is lost.
CONTACT_WEBHOOK_URL=

# Optional: WhatsApp contact used by the floating button and forms.
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
